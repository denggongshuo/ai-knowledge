# ============================================================
# ai_knowledge_web 环境变量模板（T-013）
#
# 用法：cp .env.example .env  然后按需改值。
# .env 已被 gitignore（根 .gitignore 与模块 .gitignore 各有一条），**永不入库**。
#
# 加载方式有两条路（见 application.yml 顶部注释）：
#   1) springboot4-dotenv 读**当前工作目录**下的 .env
#   2) 原生 spring.config.import 兜底：./.env 与 ./ai_knowledge_web/.env
# 所以从「模块目录」或「仓库根」启动都能命中，IDE 直接 Run main 也行。
#
# 变量名与 docker-compose.yml 的容器口径一致（kb-mysql / kb-minio /
# milvus-standalone / kb-neo4j / kb-valkey），改端口要两边一起改。
# ============================================================

# ------------------------------------------------------------
# 【必填】没有默认值，缺了启动即失败
# ------------------------------------------------------------

# JWT：HS256 密钥，至少 32 字节。用 openssl rand -base64 48 生成。
JWT_SECRET=change_me_at_least_32_bytes_long_secret_key

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=knowledge_base
MYSQL_USERNAME=kb_user
MYSQL_PASSWORD=kb_password

NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_password_here        # 必须与 docker-compose 的 NEO4J_AUTH 一致

MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=rag-documents               # bucket 由应用启动时自动创建，不用手工建

MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_USERNAME=
MILVUS_PASSWORD=

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------------------------
# 【模型】四类模型 = CHAT / EMBEDDING / RERANK / VL
#
# ⚠️ 换模型 = 换向量空间：EMBEDDING 是**全局单例**（bge-m3 / 1024 维 / L2），
#    换掉必须全量重建向量（38,502 分片），不是改个字符串的事。
#
# base-url 要写全：Spring AI 把 base-url 原样透传给 OpenAI SDK，
# 不做 /v1 补全（硅基流动要带 /v1，DeepSeek 两种写法都通）。
#
# 全部给空默认值：缺 key 时是「调用时报错」而不是「启动即失败」，
# 本地只调存储、不调模型的场景仍然能起来。
# ------------------------------------------------------------

# 对话模型（DeepSeek）
CHAT_API_KEY=
CHAT_BASE_URL=https://api.deepseek.com
CHAT_MODEL=deepseek-flash

# 嵌入模型（硅基流动 bge-m3，1024 维 —— 决策 D-4，改不得）
# 注意变量名是 EMBEDDED_ 而不是 EMBEDDING_，这是项目既有命名，勿单方面改名。
EMBEDDED_API_KEY=
EMBEDDED_API_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDED_API_MODEL=BAAI/bge-m3

# 重排模型（全局唯一，切换即时生效）
RERANKER_API_KEY=
RERANKER_API_BASE_URL=https://api.siliconflow.cn/v1
RERANKER_API_MODEL=BAAI/bge-reranker-v2-m3

# 视觉模型（图片 → 文字描述；只传描述不传原图）
VL_API_KEY=
VL_API_BASE_URL=https://api.siliconflow.cn/v1
VL_API_MODEL=Qwen/Qwen3-VL-8B-Instruct

# ------------------------------------------------------------
# 【未接入】以下 4 项当前**没有任何消费方**，保留仅为占位
#   OPENAI_API_KEY —— Spring AI 的 key 走 app.model.*（CHAT_API_KEY /
#                     EMBEDDED_API_KEY），此处用不上
#   OCR_API_*      —— 扫描件 OCR 兜底 v1 明确不做（进度《01》§明确不做）；
#                     需求里 OCR 只是告警文案里的建议动作，无接口
# 接线时再补 application.yml 的 app.model.* 段，别只填这里。
# ------------------------------------------------------------
OPENAI_API_KEY=dummy
OCR_API_KEY=
OCR_API_BASE_URL=https://api.siliconflow.cn/v1
OCR_API_MODEL=deepseek-ai/DeepSeek-OCR

# ------------------------------------------------------------
# 【可选】都有默认值，不填也能起
# ------------------------------------------------------------

# 服务端口。默认 8080；前端 Vite proxy 目标也是 8080。
# 注意：若宿主环境已导出 SERVER__PORT / SERVER_PORT，Spring 宽松绑定会把它
# 当成 server.port，于是端口不可控。验证启动时用命令行参数覆盖：
#   --server.port=18080     （命令行参数优先级高于环境变量）
# SERVER_PORT=8080

# CORS 允许来源，逗号分隔。开发期前端走 Vite proxy 是同源，此为直连兜底。
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# true = 启动自检发现任一存储不可用就拒绝启动（CI / spike 取证用）
# false = 只输出报告并继续启动（本地开发默认，缺容器时不耽误调其它功能）
# STORAGE_FAIL_FAST=false

# ---------------------------------------------------------------
# 恶意内容扫描（T-O04 · 优化/O4 步 3）
#
# 🔴 默认 false —— 与 `O4` §6 的取舍一致：**未部署时降级为跳过 + 标记，不阻断**。
#    ClamAV 常驻约 1GB 内存，而本地 docker 已经跑着 6 个服务；把它设成必装
#    等于"没装杀毒引擎就不能传文档"。
#
# 要开它：① 起容器 `docker compose --profile av up -d clamav`（首次要下几百 MB 病毒库）；
#         ② 这里置 true；③ 重启后端。
# ⚠️ 未部署时文档列表显示「未扫描」标记，**不是**静默当作已扫描（O4 判据 6）。
# ---------------------------------------------------------------
# AV_CLAMAV_ENABLED=false
# AV_CLAMAV_HOST=127.0.0.1
# AV_CLAMAV_PORT=3310
# 结论读取超时。一份 100MB 文档要几十秒，别调小
# AV_CLAMAV_READ_TIMEOUT_MS=120000
