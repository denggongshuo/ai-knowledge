<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.0</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>com.knowledge.ai</groupId>
    <artifactId>ai_knowledge_web</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>ai_knowledge_web</name>
    <description>ai_knowledge_web</description>
    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>
    <properties>
        <java.version>25</java.version>
        <spring-ai.version>2.0.1</spring-ai.version>
        <!-- JDK 23+ 默认不再隐式启用注解处理，Lombok 需要显式开启 -->
        <maven.compiler.proc>full</maven.compiler.proc>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <!--
          Web 服务端容器：Spring MVC（Servlet 栈）

          为什么显式引入 MVC 而不是只用 WebFlux：
          1) 全项目采用命令式技术栈。JPA（open-in-view=false、ddl-auto）、
             @Transactional(REQUIRES_NEW) 审计、ThreadLocal 登录上下文、
             Servlet 过滤器贯穿 traceId、分片续传上传，都是阻塞式语义。
          2) 若只保留 WebFlux，上述能力全部要改写为响应式，且 JPA 阻塞调用
             必须自行调度到 boundedElastic，风险与收益不成比例。
          3) SSE 用 SseEmitter 即可，前端基于 fetch 的流式读取不关心底层容器。

          同时保留 spring-boot-starter-webflux：它提供 WebClient，
          用于非阻塞地调用 OpenAI 兼容的 LLM / 向量化接口。
          Spring Boot 的容器判定规则：classpath 上存在 spring-webmvc 时选用
          Servlet（MVC）作为服务端容器，WebFlux 仅作为客户端能力存在。
          （见 docs/后端开发文档 与 docs/需求文档/11-非功能需求与技术架构.md §1.1）
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 参数校验（@Valid / @NotBlank / @Size ...）—— 错误码 1003x 参数类 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- .env 文件加载到环境变量 -->
        <dependency>
            <groupId>me.paulschwarz</groupId>
            <artifactId>springboot4-dotenv</artifactId>
            <version>5.1.0</version>
        </dependency>

        <!-- JPA + MySQL（业务配置存储） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
          数据库迁移（T-011）

          为什么是 Flyway 而不是 Hibernate 的 ddl-auto：
          schema 是**所有模块共用的契约**，必须能 review、能回滚、能在生产上
          按版本重放。ddl-auto=update 只能在开发期"猜"结构，改列名会悄悄加新列
          而不报错，且没有任何变更历史。这里让 Flyway 做 schema 的唯一来源，
          JPA 退到 ddl-auto=validate —— 它只负责**校验实体与表一致**，
          不一致就在启动时炸掉，而不是默默改表。

          必须是 spring-boot-starter-flyway，而不是裸的 flyway-core/flyway-mysql：
          Spring Boot 4 把自动配置按技术拆成了独立模块（spring-boot-flyway），
          FlywayAutoConfiguration **不在** spring-boot-autoconfigure 里
          （已解包确认，jar 内无任何 flyway 相关条目）。
          只引 flyway-core 的话：jar 在 classpath 上，但自动配置压根不加载 ——
          Flyway 静默不执行，紧接着 ddl-auto=validate 因"找不到表"而启动失败，
          且日志里连一行 flyway 字样都没有，极难定位。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <!--
          flyway-mysql 必须单独引：Flyway 10+ 把各数据库支持拆成独立模块，
          spring-boot-starter-flyway 只带 flyway-core（已核对其 pom，依赖仅
          spring-boot / spring-boot-jdbc / flyway-core）。
          缺了它启动时会报 "Unsupported Database: MySQL 8.0"。
        -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>

        <!-- Neo4j 图数据库（知识图谱存储） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-neo4j</artifactId>
        </dependency>

        <!-- Redis 缓存 / 会话存储 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- 1. OpenAI 兼容模型 / Embedding（OpenRouter 走 OpenAI 协议） -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>

        <!-- 2. 向量库：本地 Milvus -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-vector-store-milvus</artifactId>
        </dependency>

        <!-- 应用侧将原始文件归档到 MinIO（Milvus 服务端用的对象存储由 Milvus 自己连，此处为业务增强） -->
        <dependency>
            <groupId>io.minio</groupId>
            <artifactId>minio</artifactId>
            <version>8.5.7</version>
        </dependency>

        <!-- 监控 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>

        <!--文档处理-->
        <!--pdf-->
        <!--
            版本 2.5.0（原 1.11.0，T-0S1 spike 后升级）。
            1.11.0 的 pom 对 veraPDF 用的是**版本区间** `[1.31.0,1.32.0-RC)`，
            Maven 会取区间内最新版 → 选中 wcag-validation:1.31.171，
            而它内部引的 wcag-algorithms 解析成 1.31.44（该版本只有无参构造），
            解析 PDF 时直接 NoSuchMethodError 崩掉：
              ContrastRatioConsumer.<init>(String, String, boolean, Float)
            2.5.0 改为**固定版本**（validation-model/wcag-validation 1.31.99、
            wcag-algorithms 1.31.33），即上游修掉了这个问题；API 与 1.11.0 兼容。
        -->
        <dependency>
            <groupId>org.opendataloader</groupId>
            <artifactId>opendataloader-pdf-core</artifactId>
            <version>2.5.0</version>
        </dependency>

        <!-- Apache Tika 文档解析（支持 PDF/DOCX/PPTX/XLSX 等上千种格式） -->
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-core</artifactId>
            <version>3.2.2</version>
        </dependency>
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-parsers-standard-package</artifactId>
            <version>3.2.2</version>
        </dependency>

        <!-- Spring Security -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- JWT (jjwt) -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.12.6</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.12.6</version>
            <scope>runtime</scope>
        </dependency>

        <!-- Hutool 工具包 -->
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-all</artifactId>
            <version>5.8.38</version>
        </dependency>

        <!--
          Guava：问答入口的**令牌桶限流**（`ChatController` 提交前，全局 20 QPS 可配）。

          为什么引它：问答执行器（`chatVirtualExecutor`，`T-D07`）是**无界虚拟线程**，
          没有过载保护；本批在入口加令牌桶。Guava 的 `RateLimiter` 是成熟的令牌桶实现，
          API 极简（`create(qps)` + `tryAcquire()`），省掉手写并发正确性。

          ⚠️ 为什么钉版本：Spring Boot 4.0.0 的 BOM **不管理** `com.google.guava:guava`
          （它只管 `com.github.ben-manes.caffeine:guava`，那是别的坐标）。
          不写版本会解析失败 ⇒ 显式钉 33.4.0-jre（JDK 25 实测可用）。
          ⚠️ 本仓虽已引 Hutool，但 `hutool-all:5.8.38` **没有** RateLimiter 类（`jar tf` 零命中），替代不了。
        -->
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
            <version>33.4.0-jre</version>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <!--
                Tika 3.2.2 的 ZIP 容器探测（DefaultZipContainerDetector）调用
                ZipFile.builder()，该方法在 commons-compress 1.26 才出现；
                而 minio:8.5.7 传递引入 commons-compress 1.24.0，Maven"最近声明取胜"
                会选 1.24.0 —— 结果是**任何 DOCX/XLSX 解析都抛 NoSuchMethodError**
                （S4-M05-B 开工探针实测）。tika-parent:3.2.2 自己声明的版本是 1.28.0，
                在这里锁同版，压过 minio 的传递版本。
                修法取"依赖管理收敛"而不是给 minio 加 exclusion：
                exclusion 之后 Tika 拿不到 1.26+ 时 minio 若真用到该类会
                NoClassDefFoundError（静默埋雷）；收敛版本是标准做法，且两者实际共存良好。
                同类先例：上方 opendataloader 1.11.0 → 2.5.0（同样的 NoSuchMethodError 病因）。
            -->
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-compress</artifactId>
                <version>1.28.0</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!--
              T-711（S5-M07-B）：`@Tag("eval")` 的用例**不参与默认跑批**。

              为什么必须隔离：评测要**真调嵌入模型**（bge-m3），而 `mvn test` 的硬口径是
              「全替身、无网络」—— 那条口径是 `S5-M07-A` 花整批钉死的（它抓到过"替身没注册
              却照样绿"）。把评测混进去，跑批结果从此取决于 relay 通不通、快不快，
              而那正是最难查的偶发红（同 `src/test/resources/application.properties` 里
              关掉 `m05.enhance.enabled` 的那条理由）。

              跑法：`mvn test -Peval`（见文件末尾的 profile）。
              代价明说：评测不进 CI ⇒ 检索质量退化不会被自动发现。缓解是"结论落文档 +
              每次改检索策略手工跑一遍"，而不是假装它在门禁里。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludedGroups>eval</excludedGroups>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-compile</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                        <configuration>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>org.projectlombok</groupId>
                                    <artifactId>lombok</artifactId>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>
                    <execution>
                        <id>default-testCompile</id>
                        <phase>test-compile</phase>
                        <goals>
                            <goal>testCompile</goal>
                        </goals>
                        <configuration>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>org.projectlombok</groupId>
                                    <artifactId>lombok</artifactId>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <repositories>
        <repository>
            <id>central</id>
            <name>Maven Central</name>
            <url>https://repo.maven.apache.org/maven2</url>
            <releases>
                <enabled>true</enabled>
            </releases>
        </repository>
        <repository>
            <id>vera-dev</id>
            <url>https://artifactory.openpreservation.org/artifactory/vera-dev</url>
        </repository>
        <repository>
            <id>aliyun-central</id>
            <name>Aliyun Central</name>
            <url>https://maven.aliyun.com/repository/central</url>
            <releases>
                <enabled>true</enabled>
            </releases>
        </repository>
        <repository>
            <id>aliyun-spring</id>
            <name>Aliyun Spring</name>
            <url>https://maven.aliyun.com/repository/spring</url>
            <releases>
                <enabled>true</enabled>
            </releases>
        </repository>
    </repositories>

    <pluginRepositories>
        <pluginRepository>
            <id>aliyun-plugin</id>
            <name>Aliyun Plugin</name>
            <url>https://maven.aliyun.com/repository/public</url>
            <releases>
                <enabled>true</enabled>
            </releases>
        </pluginRepository>
    </pluginRepositories>

    <profiles>
        <!--
          T-711：跑检索质量评测集。用法 ——

              export JAVA_HOME=... && mvn -B test -Peval -Dtest=RetrievalEvalTest

          ⚠️ 它**只跑 eval 组**（`<groups>` + 清空默认的 excludedGroups），不会顺带跑一遍
          全量用例 —— 那样每次评测要多花十几分钟，而评测的价值在于"改完检索策略快速看数"。
          要全量请另开一条不带 `-Peval` 的命令。

          ⚠️ 它会**真调嵌入模型**（bge-m3）并**真写 Milvus**（探针分区，用例收尾自己丢）。
          结论落在 `target/eval-report.txt` 与 `target/eval-nprobe.txt`。
        -->
        <profile>
            <id>eval</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <groups>eval</groups>
                            <excludedGroups combine.self="override"/>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>